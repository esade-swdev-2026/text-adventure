# Normalise line endings in the repository to LF, whatever the contributor is on.
# Without this, a clone made by Git for Windows rewrites shell scripts to CRLF and a
# Linux shell cannot run them: "/usr/bin/env: 'bash\r': No such file or directory".
* text=auto eol=lf

*.png binary
*.jpg binary
*.pdf binary
uv.lock -diff
